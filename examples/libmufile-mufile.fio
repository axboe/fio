# Example libmufile job, using mufile I/O
#
# Required environment variables:
#     GPU_DEV_IDS : refer to option 'gpu_dev_ids'
#     FIO_DIR     : 'directory'. This job uses musa_io=mufile, so path(s) must
#                   point to an mtfs-supported filesystem: NVMe, NFS over RDMA,
#                   or Lustre
#
# 'direct' and 'size' differ from libmufile-posix.fio. Compare the paths with
# t/libmufile-smoke.sh.
[global]
ioengine=libmufile
directory=${FIO_DIR}
gpu_dev_ids=${GPU_DEV_IDS}
musa_io=mufile
# 'direct' must be 1 when using musa_io=mufile
direct=1
# 'bs' must be a multiple of the page size
bs=1m
size=1m
numjobs=16
# musaMalloc fails when too many processes attach to one GPU, use threads
thread
# Do not leave verify-state files in the current directory.
verify_state_save=0

[read]
rw=read

[write]
rw=write

[randread]
rw=randread

[randwrite]
rw=randwrite

[verify]
rw=write
verify=md5

[randverify]
rw=randwrite
verify=md5
