[global]
# Change the device and state-file paths before running this workload.
random_generator=tausworthe64
ba=1M
thread=1
filename=/dev/nvme0n1
direct=1
ioengine=libaio
size=100%
rcio_bs=1M
rcio_state_file=/tmp/nvme0n1-rcio.bin
group_reporting=1
iodepth=32
norandommap=1
disable_lat=1
disable_slat=1
disable_clat=1

# Precondition: random write 90% of the device
[precondition]
rcio_precondition=1
rw=randwrite
bs=1M
io_size=90%

# Main jobs: concurrent trim/write/read for 5 minutes
[randtrim]
stonewall
rw=randtrim:8
rw_sequencer=sequential
bs=128k
flow_id=1
flow=240
time_based=1
runtime=300

[randwrite]
rw=randwrite
bs=1M
flow_id=1
flow=30
time_based=1
runtime=300

[randread]
rw=randread:8
rw_sequencer=sequential
bs=128k
flow_id=1
flow=560
time_based=1
runtime=300
